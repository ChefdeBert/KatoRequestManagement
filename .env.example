# ── Core ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://kato:kato@localhost:5432/kato?schema=public
REDIS_URL=redis://localhost:6379
KATO_PUBLIC_URL=http://localhost:3000

# ── Auth (NextAuth) ─────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-openssl-rand-base64-32

# Azure AD / Entra ID (OIDC). Add the `groups` optional claim to the ID token.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Okta (OIDC). Add `groups`, `department`, `organization` claims to the ID token.
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_ISSUER=https://cassava.okta.com/oauth2/default

# Role mapping — comma-separated group object IDs (Azure) or group names (Okta)
KATO_ADMIN_GROUPS=
KATO_REVIEWER_GROUPS=
# Bootstrap admins by email (comma-separated)
KATO_ADMIN_EMAILS=
# Segregation of duties: reviewers cannot approve their own requests unless true
KATO_ALLOW_SELF_APPROVAL=false

# Local development only: email-only login (ignored when NODE_ENV=production)
KATO_DEV_LOGIN=false

# ── LLM ─────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic            # anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Optional: a different (e.g. stronger) model for the value & route assessment
ASSESSMENT_MODEL=

# ── Assessment ──────────────────────────────────────────────────────
# Approval is blocked until the value & development-route assessment completes
KATO_REQUIRE_ASSESSMENT=true
# Autonomy score thresholds (0–100) for the Autonomous and AI-assisted routes
KATO_AUTONOMOUS_MIN_SCORE=75
KATO_ASSISTED_MIN_SCORE=50

# ── Jira Cloud ──────────────────────────────────────────────────────
JIRA_BASE_URL=https://liquidtelecom.atlassian.net/
JIRA_EMAIL=svc-kato@cassava.tech
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=AISF
JIRA_EPIC_ISSUE_TYPE=Epic
JIRA_STORY_ISSUE_TYPE=Story
JIRA_SET_PRIORITY=true
# Optional JSON: Kato level → Jira priority name
JIRA_PRIORITY_MAP={"CRITICAL":"Highest","HIGH":"High","MEDIUM":"Medium","LOW":"Low"}
# Optional JSON: Kato field → Jira custom field id. Suffix ":option" for single-select fields.
# Keys: opco, businessUnit, department, sponsor, impact, urgency, katoUrl, targetDate,
#       route, confluenceUrl, revenueUsd, ebitdaUsd, cashFlowUsd, valueScore
# Suffix ":number" for number fields (e.g. "ebitdaUsd":"customfield_10080:number").
JIRA_CUSTOM_FIELDS={}
# Company-managed projects that still require "Epic Name"
JIRA_EPIC_NAME_FIELD=
JIRA_SYNC_MAX_ATTEMPTS=8

# ── Confluence Cloud (system of record for BRDs) ────────────────────
CONFLUENCE_ENABLED=true
# Defaults to ${JIRA_BASE_URL}/wiki and the Jira credentials when unset
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEY=AISF
# Optional: page under which all BRD pages are created
CONFLUENCE_PARENT_PAGE_ID=

# ── Notifications (optional SMTP; in-app notifications always recorded) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Kato <kato@cassava.tech>"
